# =========================================================================
# AERIS / WeatherGPT Environment Variables Configuration
# Copy this file to '.env' for local development.
# NEVER commit real credentials or private keys to source control!
# =========================================================================

# -------------------------------------------------------------------------
# FRONTEND VARIABLES (Publicly accessible in browser bundle via VITE_)
# -------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# -------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Private Server Secrets ONLY)
# -------------------------------------------------------------------------
PORT=5000
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=your_secure_session_secret_key_minimum_32_chars

# Database & Supabase Privileged Service Role
DATABASE_URL=data/users.json
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# AI Orchestration (OpenRouter API Secret Key)
OPENROUTER_API_KEY=your_openrouter_api_key_sk_or_v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Meteorological & Geocoding Provider API Keys
WEATHER_API_KEY=your_openweather_or_tomorrow_api_key

# Google OAuth 2.0 Credentials
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Transactional Email / SMTP Configuration (Nodemailer)
# Supports Gmail, SendGrid, Amazon SES, Resend, Mailgun
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_FROM="AERIS Intelligence" <no-reply@aeris.ai>

# Standard SMTP Aliases
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="AERIS Intelligence" <no-reply@aeris.ai>
